DATABASE_URL=sqlite:///./data/app.db
ENVIRONMENT=development
LOG_LEVEL=INFO
SQL_ECHO=false
DB_CONNECT_TIMEOUT_SECONDS=5
APP_PASSWORD=
SESSION_SECRET=dev-insecure-change-me

# Scheduler runs in Europe/Helsinki during the active window.
SCRAPE_INTERVAL_SECONDS=10800
SCRAPE_ACTIVE_START_HOUR=6
SCRAPE_ACTIVE_END_HOUR=21
PRODUCT_SCRAPE_INTERVAL_SECONDS=86400
# Remind connected websocket clients about unread jobs on this interval.
# Set to 0 to disable.
NOTIFICATION_INTERVAL_SECONDS=3600

# Optional Redis used for the distributed scrape lock. Leave empty to use the
# in-process lock only.
REDIS_URL=
REDIS_KEY_PREFIX=notification
REDIS_SOCKET_TIMEOUT_SECONDS=2
SCRAPE_LOCK_TTL_SECONDS=60
# SCRAPE_LOCK_RENEW_INTERVAL_SECONDS=20
# SCRAPE_LOCK_WAIT_TIMEOUT_SECONDS=
